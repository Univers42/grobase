 "loginAlertSuccess": {
  "to": "user@example.com",
  "subject": "Security alert: new Prismatica sign-in",
  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n\t<meta charset=\"utf-8\">\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\t<title>New Prismatica sign-in</title>\n</head>\n<body style=\"margin:0; padding:0; background:#f7f4ed; color:#1c1612; font-family:Arial, Helvetica, sans-serif;\">\n\t<main style=\"background:#f7f4ed; margin:0; padding:28px 12px;\">\n\t\t<section style=\"max-width:640px; margin:0 auto; background:#fffaf0; border:3px solid #1c1612; border-radius:24px; box-shadow:8px 8px 0 #1c1612; overflow:hidden;\">\n\t\t\t<header style=\"padding:28px 28px 12px 28px;\">\n\t\t\t\t<p style=\"margin:0 0 10px 0; font-size:14px; letter-spacing:.08em; text-transform:uppercase; color:#6f5f42;\">Security alert</p>\n\t\t\t\t<h1 style=\"margin:0; font-size:34px; line-height:1.05; color:#1c1612; font-family:Georgia, 'Times New Roman', serif;\">New sign-in to Prismatica</h1>\n\t\t\t</header>\n\t\t\t<div style=\"padding:12px 28px 0 28px;\">\n\t\t\t\t<p style=\"margin:0 0 18px 0; font-size:17px; line-height:1.55;\">Hello user@example.com,</p>\n\t\t\t\t<p style=\"margin:0 0 20px 0; font-size:17px; line-height:1.55;\">We detected Prismatica sign-in activity on your account. Review the details below to make sure this was you.</p>\n\t\t\t\t<div style=\"margin:22px 0; border:2px solid #1c1612; background:#fffdf6;\">\n\t\t\t\t\t<p style=\"margin:0; padding:12px; border-bottom:1px solid #1c1612; font-size:15px; line-height:1.45;\"><strong style=\"display:block; margin-bottom:4px; font-size:14px; text-transform:uppercase; letter-spacing:.04em;\">Outcome</strong>Successful sign-in</p>\n\t\t\t\t\t<p style=\"margin:0; padding:12px; border-bottom:1px solid #1c1612; font-size:15px; line-height:1.45;\"><strong style=\"display:block; margin-bottom:4px; font-size:14px; text-transform:uppercase; letter-spacing:.04em;\">When</strong>Saturday, 17 October 2026 at 10:00:00 UTC (UTC)</p>\n\t\t\t\t\t<p style=\"margin:0; padding:12px; border-bottom:1px solid #1c1612; font-size:15px; line-height:1.45;\"><strong style=\"display:block; margin-bottom:4px; font-size:14px; text-transform:uppercase; letter-spacing:.04em;\">IP address</strong>203.0.113.7</p>\n\t\t\t\t\t<p style=\"margin:0; padding:12px; border-bottom:1px solid #1c1612; font-size:15px; line-height:1.45;\"><strong style=\"display:block; margin-bottom:4px; font-size:14px; text-transform:uppercase; letter-spacing:.04em;\">Location</strong>Local development or private network</p>\n\t\t\t\t\t<p style=\"margin:0; padding:12px; border-bottom:1px solid #1c1612; font-size:15px; line-height:1.45;\"><strong style=\"display:block; margin-bottom:4px; font-size:14px; text-transform:uppercase; letter-spacing:.04em;\">How</strong>Successful password sign-in through the Prismatica auth gateway</p>\n\t\t\t\t\t<p style=\"margin:0; padding:12px; border-bottom:1px solid #1c1612; font-size:15px; line-height:1.45;\"><strong style=\"display:block; margin-bottom:4px; font-size:14px; text-transform:uppercase; letter-spacing:.04em;\">Where</strong>https://localhost:4322</p>\n\t\t\t\t\t<p style=\"margin:0; padding:12px; font-size:15px; line-height:1.45; word-break:break-word;\"><strong style=\"display:block; margin-bottom:4px; font-size:14px; text-transform:uppercase; letter-spacing:.04em;\">Device</strong>Mozilla/5.0</p>\n\t\t\t\t</div>\n\t\t\t\t<div style=\"border:2px dashed #1c1612; border-radius:16px; padding:16px; background:#f7f4ed;\">\n\t\t\t\t\t<p style=\"margin:0 0 10px 0; font-size:15px; line-height:1.5;\"><strong>If this was you:</strong> no action is required.</p>\n\t\t\t\t\t<p style=\"margin:0; font-size:15px; line-height:1.5;\"><strong>If this was not you:</strong> reset your password immediately and contact Prismatica support. This alert was sent to help you detect unauthorized access quickly.</p>\n\t\t\t\t</div>\n\t\t\t\t<p style=\"margin:22px 0 8px 0; font-size:14px; line-height:1.5; color:#4b4238;\">Request metadata: origin https://localhost:4322 \u00b7 referer not sent \u00b7 forwarded for not sent</p>\n\t\t\t</div>\n\t\t\t<footer style=\"padding:22px 28px 28px 28px; border-top:2px solid #1c1612; background:#f0eadc;\">\n\t\t\t\t<p style=\"margin:0 0 8px 0; font-size:13px; line-height:1.45; color:#4b4238;\">Prismatica security notifications are mandatory account-protection emails.</p>\n\t\t\t\t<p style=\"margin:0; font-size:13px; line-height:1.45;\"><a href=\"https://localhost:4322/legal/privacy-policy/\" style=\"color:#1c1612; font-weight:700;\">Privacy Policy</a></p>\n\t\t\t</footer>\n\t\t</section>\n\t</main>\n</body>\n</html>\n"
 },
