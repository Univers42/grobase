  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light\">\n<meta name=\"supported-color-schemes\" content=\"light\">\n<title>Reset your password</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#F6F5F1;\">\n<div style=\"display:none;max-height:0;overflow:hidden;opacity:0;color:#F6F5F1;\">A password reset was requested for user@example.com.</div>\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F6F5F1;\">\n<tr><td align=\"center\" style=\"padding:40px 16px;\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:560px;\">\n<tr><td style=\"padding:0 0 20px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;font-weight:600;letter-spacing:0.02em;color:#15151A;\">Prismatica</td></tr>\n<tr><td style=\"background-color:#FFFFFF;border:1px solid #DCDAD2;border-radius:6px;padding:32px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#15151A;\">\n<h1 style=\"margin:0 0 16px 0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:24px;line-height:1.25;font-weight:600;color:#15151A;\">Reset your password</h1>\n<p style=\"margin:0 0 16px 0;font-size:16px;line-height:1.5;color:#15151A;\">A password reset was requested for the Prismatica account user@example.com. Choose a new password with the button below.</p>\n<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"><tr><td bgcolor=\"#B93A0C\" style=\"border-radius:4px;background-color:#B93A0C;\"><a href=\"https://localhost:4322/auth/reset#token_hash=abc&amp;type=signup&amp;sig=def\" style=\"display:inline-block;padding:12px 20px;font-family:-apple-system,BlinkMacSystemFont,