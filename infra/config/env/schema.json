{
  "version": 1,
  "$comment": "Authoritative classification of every env key. See docs/infrastructure/configuration.md. consumers[] are evidence from `docker compose --profile \"*\" config`.",
  "categories": {
    "SECRET": "Proves identity or grants access. Never committed; lives in vault42, reaches runtime by injection.",
    "CONFIG": "Non-sensitive behaviour. Committed in config.env.",
    "PUBLIC": "Safe to ship to a browser. Assume anyone can read it.",
    "ENVIRONMENT": "Identity of the deployment itself.",
    "INFRASTRUCTURE": "What exists \u2014 compose planes, helm charts. Not an env key.",
    "DEPLOYMENT": "Image tag / commit, stamped at build (gate m190)."
  },
  "environments": [
    "local",
    "dev",
    "staging",
    "prod"
  ],
  "vault42": {
    "org": "univers-42",
    "org_name": "Univers42",
    "project": "grobase",
    "team": "transcendence",
    "path": "<group>/<KEY>",
    "grants": {
      "local": "write",
      "dev": "write",
      "staging": "read",
      "prod": "read"
    }
  },
  "rules": [
    "A key absent from this file defaults to CONFIG; a SECRET must be listed.",
    "No SECRET may carry a literal default in compose (gate m214).",
    "A derived key is rebuilt from its parts by its built_by (generate-env.sh, or a compose nested default), never stored twice.",
    "No SECRET may appear in a PUBLIC_*/VITE_*/NEXT_PUBLIC_* name."
  ],
