# ==========================================================================
# .env.example - GENERATED from infra/config/env/schema.json. Do not edit.
#
#   regenerate:  bash scripts/env/render-example.sh --write
#   verify:      make env-example-check      (exits 1 when this file drifted)
#
# This is a schema document, not a file to copy: it lists every key the
# platform classifies, who may know its value, and where that value lives.
#
# Configuration is three layers. A later layer overrides an earlier one, and
# `make env` assembles them into .env (rebuilt every time, never edit it):
#
#   config.env  <  .env.secrets  <  .env.local   ->   .env
#
#   config.env    committed. Non-secret config: hosts, URLs, names, tuning.
#   .env.secrets  generated by `make env`, gitignored, mode 600. The minted
#                 secrets. Source of truth for a SECRET is vault42.
#   .env.local    optional, gitignored. Per-developer overrides and the
#                 external keys (OAuth, LLM, SMTP). Template: .env.local.example.
#
# Placeholders: CHANGE_ME = required, you must supply it. Empty = optional.
# A commented-out key is derived; it is rebuilt, never set by hand. No real
# value belongs in this file (gate m214 refuses one).
# ==========================================================================

# Environments: local, dev, staging, prod
# vault42 home: univers-42/grobase, a SECRET lives at <group>/<KEY>

# ==========================================================================
# ENVIRONMENT: Identity of the deployment itself.
# ==========================================================================

# ENVIRONMENT | required in all environments | format enum(local|dev|staging|prod)
GROBASE_ENV=local

# ==========================================================================
# CONFIG: Non-sensitive behaviour. Committed in config.env.
# ==========================================================================

# CONFIG | optional | format url
MONGO_URI=

# ==========================================================================
# PUBLIC: Safe to ship to a browser. Assume anyone can read it.
# ==========================================================================

# PUBLIC | required in all environments | format jwt-hs256 | compose-required | browser-safe
ANON_KEY=CHANGE_ME

# PUBLIC | optional | format url | browser-safe
API_EXTERNAL_URL=

# PUBLIC | optional | format opaque | browser-safe
FORTYTWO_CLIENT_ID=

# PUBLIC | optional | format url | browser-safe
FRONTEND_URL=

# PUBLIC | optional | format opaque | browser-safe
GITHUB_CLIENT_ID=

# PUBLIC | optional | format opaque | browser-safe
GOOGLE_CLIENT_ID=

# PUBLIC | optional | format url | browser-safe
GOTRUE_SITE_URL=

# PUBLIC | required in all environments | format jwt-hs256 | browser-safe
KONG_PUBLIC_API_KEY=CHANGE_ME

# PUBLIC | optional | format url | browser-safe
SUPABASE_PUBLIC_URL=

# ==========================================================================
# SECRET: Proves identity or grants access. Never committed; lives in vault42, reaches runtime by injection.
# ==========================================================================

# SECRET | required in all environments | format hex64 | vault42 core/ADAPTER_REGISTRY_SERVICE_TOKEN
ADAPTER_REGISTRY_SERVICE_TOKEN=CHANGE_ME

# SECRET | required in all environments | format alnum24 | vault42 postgres/AUTHENTICATOR_PASSWORD | compose-required
AUTHENTICATOR_PASSWORD=CHANGE_ME

# SECRET | optional | format opaque | vault42 oauth/FORTYTWO_CLIENT_SECRET
FORTYTWO_CLIENT_SECRET=

# SECRET | optional | format opaque | vault42 github/GITHUB_APP_PRIVATE_KEY
GITHUB_APP_PRIVATE_KEY=

# SECRET | optional | format opaque | vault42 oauth/GITHUB_CLIENT_SECRET
GITHUB_CLIENT_SECRET=

# SECRET | optional | format opaque | vault42 oauth/GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=

# SECRET | required in all environments | format kid:hex64 | vault42 core/INTERNAL_IDENTITY_HMAC_KEYS
INTERNAL_IDENTITY_HMAC_KEYS=CHANGE_ME

# SECRET | required in all environments | format hex64 | vault42 core/JWT_SECRET | compose-required
JWT_SECRET=CHANGE_ME

# SECRET | optional | format opaque | vault42 core/KEY_HASH_PEPPER
KEY_HASH_PEPPER=

# SECRET | required in all environments | format jwt-hs256 | vault42 kong/KONG_SERVICE_API_KEY
KONG_SERVICE_API_KEY=CHANGE_ME

# SECRET | optional | format opaque | vault42 llm/LLM_API_KEY
LLM_API_KEY=

# SECRET | required in all environments | format alnum32 | vault42 logs/LOG_STREAM_TOKEN
LOG_STREAM_TOKEN=CHANGE_ME

# SECRET | required in all environments | format alnum24 | vault42 mariadb/MARIADB_PASSWORD | compose-required
MARIADB_PASSWORD=CHANGE_ME

# SECRET | required in all environments | format alnum24 | vault42 mariadb/MARIADB_ROOT_PASSWORD | compose-required
MARIADB_ROOT_PASSWORD=CHANGE_ME

# SECRET | required in all environments | format hex32 | vault42 storage/MINIO_ROOT_PASSWORD | compose-required
MINIO_ROOT_PASSWORD=CHANGE_ME

# SECRET | required in all environments | format alnum24 | vault42 mongo/MONGO_INITDB_ROOT_PASSWORD | compose-required
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME

# SECRET | required in all environments | format complex20 | vault42 mssql/MSSQL_SA_PASSWORD | compose-required
MSSQL_SA_PASSWORD=CHANGE_ME

# SECRET | required in all environments | format alnum24 | vault42 mysql/MYSQL_PASSWORD | compose-required
MYSQL_PASSWORD=CHANGE_ME

# SECRET | required in all environments | format alnum24 | vault42 mysql/MYSQL_ROOT_PASSWORD | compose-required
MYSQL_ROOT_PASSWORD=CHANGE_ME

# SECRET | required in all environments | format alnum24 | vault42 postgres/POSTGRES_PASSWORD | compose-required
POSTGRES_PASSWORD=CHANGE_ME

# SECRET | optional | format opaque | vault42 push/PUSH_SECRET_KEY
PUSH_SECRET_KEY=

# SECRET | required in all environments | format hex64 | vault42 pooler/SECRET_KEY_BASE | compose-required
SECRET_KEY_BASE=CHANGE_ME

# SECRET | required in all environments | format jwt-hs256 | vault42 kong/SERVICE_ROLE_KEY | compose-required
SERVICE_ROLE_KEY=CHANGE_ME

# SECRET | optional | format opaque | vault42 smtp/SMTP_PASS
SMTP_PASS=

# SECRET | optional | format opaque | vault42 sso/SSO_SECRET_KEY
SSO_SECRET_KEY=

# SECRET | optional | format opaque | vault42 stripe/STRIPE_API_KEY
STRIPE_API_KEY=

# SECRET | required in all environments | format hex32 | vault42 control/VAULT_ENC_KEY | compose-required
VAULT_ENC_KEY=CHANGE_ME

# SECRET | required in all environments | derived
# Derived, not stored in vault42: scripts/env/generate-env.sh (written into .env.secrets) builds it from POSTGRES_DB, POSTGRES_PASSWORD.
# ADAPTER_REGISTRY_DATABASE_URL=

# SECRET | required in all environments | derived | compose-required
# Derived, not stored in vault42: scripts/env/generate-env.sh (written into .env.secrets) builds it from POSTGRES_DB, POSTGRES_HOST, POSTGRES_PASSWORD.
# DATABASE_URL=

# SECRET | required in all environments | derived
# Derived, not stored in vault42: scripts/env/generate-env.sh (written into .env.secrets) builds it from AUTHENTICATOR_PASSWORD, POSTGRES_DB.
# PGRST_DB_URI=

# SECRET | optional | derived
# Derived, not stored in vault42: compose nested default -> DATABASE_URL (orchestrators/compose/base/ops.yml:13) builds it from POSTGRES_DB, POSTGRES_PASSWORD.
# PG_BACKUP_DATABASE_URL=

# SECRET | optional | derived | vault42 storage/S3_ACCESS_KEY
# Derived, not stored in vault42: compose (orchestrators/compose/base/app-services.yml:265) builds it from MINIO_ROOT_USER.
# S3_ACCESS_KEY=

# SECRET | optional | derived | vault42 storage/S3_SECRET_KEY
# Derived, not stored in vault42: compose (orchestrators/compose/base/app-services.yml:266) builds it from MINIO_ROOT_PASSWORD.
# S3_SECRET_KEY=
